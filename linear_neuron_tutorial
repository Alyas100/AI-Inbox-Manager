      "source": [
        "## Neural Network incorporating 2 hidden layer, with activation function(ReLu) and biases"
      ],
      "metadata": {
        "id": "_cMHKIfJhfdQ"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "FLOW:\n",
        "x (input)-> Layer 1(ReLu)-> Layer 2(ReLu)-> output(no activation)-> y_pred\n"
      ],
      "metadata": {
        "id": "WZ7QRr1M9nUH"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "#Data\n",
        "x = 2.0\n",
        "target = 17.0\n",
        "\n",
        "#Hyperparameters\n",
        "lr = 0.01 #learning rate\n",
        "epochs = 10000 #act as cycle on how many time to iterate for finding closer to target value\n",
        "\n",
        "#Initialize weights and biases for weight 1-3\n",
        "w1 = random.uniform(-1, 1)\n",
        "b1 = random.uniform(-1, 1)\n",
        "\n",
        "w2 = random.uniform(-1, 1)\n",
        "b2 = random.uniform(-1, 1)\n",
        "\n",
        "w3 = random.uniform(-1, 1)\n",
        "b3 = random.uniform(-1, 1)\n",
        "\n",
        "#ReLU activation\n",
        "#is CRUCIAL for model to learn complex pattern(non-linear) instead of just linear pattern\n",
        "#omitting this will result into multiple layer that have defined to collapse into one quivalent linear layer only\n",
        "def relu(x):\n",
        "    return x if x > 0 else 0\n",
        "\n",
        "#slope for y=x in relu fucn is 1, and 0 for y=0(flat line)\n",
        "def relu_derivative(x):\n",
        "    return 1 if x > 0 else 0\n",
        "\n",
        "#Training loop\n",
        "for i in range(epochs):\n",
        "    #Forward pass (only apply to equation with weight 1 and 2)\n",
        "    #z stands for input for pre-activation layer\n",
        "    z1 = w1 * x + b1\n",
        "    a1 = relu(z1) #inserted into activation layer\n",
        "\n",
        "    z2 = w2 * a1 + b2\n",
        "    a2 = relu(z2)\n",
        "\n",
        "    y_pred = w3 * a2 + b3  #output layer (no activation for for this weight)\n",
        "\n",
        "    #calculate loss (MSE)\n",
        "    #mathematical formula in general for all kind of loss function(not necesarily for regression only) is:\n",
        "    #L=Loss(a2,target) for this case using a2 for previous hidden layer\n",
        "    #chain of dependecies look like this: x→z1​→a1​→z2​→a2​→L\n",
        "    loss = (y_pred - target) ** 2\n",
        "\n",
        "    # Backpropagation\n",
        "    dL_dy = 2 * (y_pred - target) #to know how much y_pred should be changed to decrease loss later in grad_decent\n",
        "    #then we do with respect to last weight for output and for last bias, so we can know how much need to change that will affect loss\n",
        "    dL_dw3 = dL_dy * a2 #a2 is after differnetiated (dy/dw3)\n",
        "    dL_db3 = dL_dy #with respect to bias,in this case dy/db is 1, this also means that increasing b by 1 increases y_pred by one too directly\n",
        "\n",
        "    #find the derivative for the two previous (weight 1, and 2)\n",
        "    #same as previous, the order must always be from w.r.t output in current layer, weight and biases cause these are the core thing we want to see how many changes needed to alter the loss. But these two hidden layer below have one addition derivative that need to find, which are z2(before applying ReLU).\n",
        "    dL_da2 = dL_dy * w3\n",
        "    dL_dz2 = dL_da2 * relu_derivative(z2)\n",
        "    dL_dw2 = dL_dz2 * a1\n",
        "    dL_db2 = dL_dz2\n",
        "\n",
        "    dL_da1 = dL_dz2 * w2\n",
        "    dL_dz1 = dL_da1 * relu_derivative(z1)\n",
        "    dL_dw1 = dL_dz1 * x\n",
        "    dL_db1 = dL_dz1\n",
        "\n",
        "    # Gradient update for all these three weights\n",
        "    w3 -= lr * dL_dw3\n",
        "    b3 -= lr * dL_db3\n",
        "\n",
        "    w2 -= lr * dL_dw2\n",
        "    b2 -= lr * dL_db2\n",
        "\n",
        "    w1 -= lr * dL_dw1\n",
        "    b1 -= lr * dL_db1\n",
        "\n",
        "    # to see how close to optimal value '17.0'\n",
        "    print(y_pred)\n",
        "\n"
      ],
