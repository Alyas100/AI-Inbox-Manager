      "cell_type": "markdown",
      "source": [
        "## predicting house price using 3 feature input, and two hidden layer(each contain 3 neuron), and output layer contain 1 neuron, that receice three inputs from output of its previous hidden layer"
      ],
      "metadata": {
        "id": "W9WEk2cjWHZ9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "# --- Input and Target ---\n",
        "x1, x2, x3 = 120.0, 3.0, 10.0   # [size, bedrooms, age]\n",
        "target = 300000.0               # house price\n",
        "\n",
        "# --- Hyperparameters ---\n",
        "lr = 0.01\n",
        "epochs = 10000\n",
        "\n",
        "# --- Helper function ---\n",
        "def rand():\n",
        "    return random.uniform(-1, 1)\n",
        "\n",
        "# --- Initialize weights and biases manually ---\n",
        "# Hidden Layer 1 (3 neurons, 3 inputs each)\n",
        "w1_1 = [rand(), rand(), rand()]\n",
        "w1_2 = [rand(), rand(), rand()]\n",
        "w1_3 = [rand(), rand(), rand()]\n",
        "b1_1, b1_2, b1_3 = rand(), rand(), rand()\n",
        "\n",
        "# Hidden Layer 2 (3 neurons, 3 inputs each)\n",
        "w2_1 = [rand(), rand(), rand()]\n",
        "w2_2 = [rand(), rand(), rand()]\n",
        "w2_3 = [rand(), rand(), rand()]\n",
        "b2_1, b2_2, b2_3 = rand(), rand(), rand()\n",
        "\n",
        "# Output Layer (1 neuron, 3 inputs)\n",
        "w3 = [rand(), rand(), rand()]\n",
        "b3 = rand()\n",
        "\n",
        "# --- Activation functions ---\n",
        "def relu(x):\n",
        "    return x if x > 0 else 0\n",
        "\n",
        "def relu_deriv(x):\n",
        "    return 1 if x > 0 else 0\n",
        "\n",
        "# --- Training loop ---\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    # --- Forward Pass ---\n",
        "    # Hidden Layer 1\n",
        "    z1_1 = w1_1[0]*x1 + w1_1[1]*x2 + w1_1[2]*x3 + b1_1\n",
        "    z1_2 = w1_2[0]*x1 + w1_2[1]*x2 + w1_2[2]*x3 + b1_2\n",
        "    z1_3 = w1_3[0]*x1 + w1_3[1]*x2 + w1_3[2]*x3 + b1_3\n",
        "    a1_1, a1_2, a1_3 = relu(z1_1), relu(z1_2), relu(z1_3)\n",
        "\n",
        "    # Hidden Layer 2\n",
        "    z2_1 = w2_1[0]*a1_1 + w2_1[1]*a1_2 + w2_1[2]*a1_3 + b2_1\n",
        "    z2_2 = w2_2[0]*a1_1 + w2_2[1]*a1_2 + w2_2[2]*a1_3 + b2_2\n",
        "    z2_3 = w2_3[0]*a1_1 + w2_3[1]*a1_2 + w2_3[2]*a1_3 + b2_3\n",
        "    a2_1, a2_2, a2_3 = relu(z2_1), relu(z2_2), relu(z2_3)\n",
        "\n",
        "    # Output Layer\n",
        "    y_pred = w3[0]*a2_1 + w3[1]*a2_2 + w3[2]*a2_3 + b3\n",
        "\n",
        "    # --- Loss ---\n",
        "    loss = (y_pred - target) ** 2\n",
        "\n",
        "    # --- Backpropagation ---\n",
        "    dL_dy = 2 * (y_pred - target)\n",
        "\n",
        "    # Output layer gradients\n",
        "    dL_dw3_0 = dL_dy * a2_1\n",
        "    dL_dw3_1 = dL_dy * a2_2\n",
        "    dL_dw3_2 = dL_dy * a2_3\n",
        "    dL_db3 = dL_dy\n",
        "\n",
        "    # Hidden layer 2\n",
        "    dL_da2_1 = dL_dy * w3[0]\n",
        "    dL_da2_2 = dL_dy * w3[1]\n",
        "    dL_da2_3 = dL_dy * w3[2]\n",
        "\n",
        "    dL_dz2_1 = dL_da2_1 * relu_deriv(z2_1)\n",
        "    dL_dz2_2 = dL_da2_2 * relu_deriv(z2_2)\n",
        "    dL_dz2_3 = dL_da2_3 * relu_deriv(z2_3)\n",
        "\n",
        "    # Gradients for w2\n",
        "    dL_dw2_1 = [dL_dz2_1 * a1_1, dL_dz2_1 * a1_2, dL_dz2_1 * a1_3]\n",
        "    dL_dw2_2 = [dL_dz2_2 * a1_1, dL_dz2_2 * a1_2, dL_dz2_2 * a1_3]\n",
        "    dL_dw2_3 = [dL_dz2_3 * a1_1, dL_dz2_3 * a1_2, dL_dz2_3 * a1_3]\n",
        "    dL_db2_1, dL_db2_2, dL_db2_3 = dL_dz2_1, dL_dz2_2, dL_dz2_3\n",
        "\n",
        "    # Hidden layer 1\n",
        "    dL_da1_1 = dL_dz2_1*w2_1[0] + dL_dz2_2*w2_2[0] + dL_dz2_3*w2_3[0]\n",
        "    dL_da1_2 = dL_dz2_1*w2_1[1] + dL_dz2_2*w2_2[1] + dL_dz2_3*w2_3[1]\n",
        "    dL_da1_3 = dL_dz2_1*w2_1[2] + dL_dz2_2*w2_2[2] + dL_dz2_3*w2_3[2]\n",
        "\n",
        "    dL_dz1_1 = dL_da1_1 * relu_deriv(z1_1)\n",
        "    dL_dz1_2 = dL_da1_2 * relu_deriv(z1_2)\n",
        "    dL_dz1_3 = dL_da1_3 * relu_deriv(z1_3)\n",
        "\n",
        "    dL_dw1_1 = [dL_dz1_1 * x1, dL_dz1_1 * x2, dL_dz1_1 * x3]\n",
        "    dL_dw1_2 = [dL_dz1_2 * x1, dL_dz1_2 * x2, dL_dz1_2 * x3]\n",
        "    dL_dw1_3 = [dL_dz1_3 * x1, dL_dz1_3 * x2, dL_dz1_3 * x3]\n",
        "    dL_db1_1, dL_db1_2, dL_db1_3 = dL_dz1_1, dL_dz1_2, dL_dz1_3\n",
        "\n",
        "    # --- Update weights ---\n",
        "    # Output layer\n",
        "    w3[0] -= lr * dL_dw3_0\n",
        "    w3[1] -= lr * dL_dw3_1\n",
        "    w3[2] -= lr * dL_dw3_2\n",
        "    b3 -= lr * dL_db3\n",
        "\n",
        "    # Hidden layer 2\n",
        "    for i in range(3):\n",
        "        w2_1[i] -= lr * dL_dw2_1[i]\n",
        "        w2_2[i] -= lr * dL_dw2_2[i]\n",
        "        w2_3[i] -= lr * dL_dw2_3[i]\n",
        "    b2_1 -= lr * dL_db2_1\n",
        "    b2_2 -= lr * dL_db2_2\n",
        "    b2_3 -= lr * dL_db2_3\n",
        "\n",
        "    # Hidden layer 1\n",
        "    for i in range(3):\n",
        "        w1_1[i] -= lr * dL_dw1_1[i]\n",
        "        w1_2[i] -= lr * dL_dw1_2[i]\n",
        "        w1_3[i] -= lr * dL_dw1_3[i]\n",
        "    b1_1 -= lr * dL_db1_1\n",
        "    b1_2 -= lr * dL_db1_2\n",
        "    b1_3 -= lr * dL_db1_3\n",
        "\n",
        "    if epoch % 1000 == 0:\n",
        "        print(f\"Epoch {epoch}: Predicted={y_pred:.2f}, Loss={loss:.2f}\")\n",
        "\n",
        "# --- Final Output ---\n",
        "print(\"\\nFinal Prediction:\", y_pred)\n",
        "print(\"Target:\", target)\n"
      ],
